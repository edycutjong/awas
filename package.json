{
  "name": "awas",
  "version": "0.1.0",
  "private": true,
  "description": "Paste a job ad; Awas builds an evidence file where every line is a URL plus a verbatim quote that code has verified against the fetched page, then says STOP or VERIFY FIRST.",
  "license": "MIT",
  "homepage": "https://awas.edycu.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edycutjong/awas.git"
  },
  "bugs": {
    "url": "https://github.com/edycutjong/awas/issues"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "audit": "npm audit --omit=dev --audit-level=high",
    "ci": "npm run lint && npm run typecheck && npm run test:coverage && npm run audit",
    "lint:fix": "eslint . --fix",
    "e2e:ui": "playwright test --ui",
    "lighthouse": "npx --yes @lhci/cli@0.14.x autorun",
    "build:lab": "node scripts/build-lab.mjs"
  },
  "dependencies": {
    "next": "^15.5.27",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.27",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "postcss": "8.5.28"
  }
}
